---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About | Ahmad Rasti Barzoki';
const description = 'About Ahmad Rasti Barzoki, a technology leader, data scientist and AI/ML researcher with a background in applied mathematics and data science.';

const profilePageSchema = {
  '@type': 'ProfilePage',
  '@id': 'https://ahmadrastibarzoki.ir/about#profile-page',
  url: 'https://ahmadrastibarzoki.ir/about',
  name: 'About Ahmad Rasti Barzoki',
  mainEntity: {
    '@id': 'https://ahmadrastibarzoki.ir/#person'
  },
  isPartOf: {
    '@id': 'https://ahmadrastibarzoki.ir/#website'
  },
  inLanguage: 'en'
};
---

<BaseLayout
  title={title}
  description={description}
  schema={profilePageSchema}
  image="/images/about-portrait.png"
  imageAlt="Portrait of Ahmad Rasti Barzoki"
  ogType="profile"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>Research mindset. Production perspective.</h1>
      <p class="lead">
        I work across data science, machine learning, research and technology leadership,
        with a focus on turning rigorous ideas into useful systems.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container two-col">
      <aside class="profile-card">
        <img
          class="profile-photo"
          src="/images/about-portrait-900.webp"
          srcset="/images/about-portrait-480.webp 480w, /images/about-portrait-900.webp 900w"
          sizes="(max-width: 920px) calc(100vw - 2rem), 360px"
          width="900"
          height="1125"
          alt="Portrait of Ahmad Rasti Barzoki"
          loading="lazy"
          decoding="async"
        />
        <div class="profile-body">
          <h3>Ahmad Rasti Barzoki</h3>
          <p class="section-copy">Technology Leader · Data Scientist · AI/ML Researcher</p>
        </div>
      </aside>

      <div class="prose">
        <p>
          I’m <strong>Ahmad Rasti Barzoki</strong>. My background combines applied mathematics,
          data science, machine learning research, analytics engineering and enterprise technology.
        </p>
        <p>
          I hold an M.Sc. in <strong>Applied Mathematics — Data Science</strong> from
          Isfahan University of Technology. My research interests include graph neural networks,
          graph representation learning, unsupervised anomaly detection, deep learning,
          applied AI and responsible generative AI.
        </p>
        <p>
          Alongside research, I have worked on practical data and technology problems involving
          analytics, forecasting, enterprise systems, automation and AI-enabled decision support.
        </p>
        <p>
          I use this site as the canonical home for my projects, research, publications and professional work.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
