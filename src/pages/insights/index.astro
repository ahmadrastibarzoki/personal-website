---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  estimateReadingTime,
  formatInsightDate,
  getPublishedInsights
} from '../../utils/insights';

const title = 'Insights | Ahmad Rasti Barzoki';
const description = 'Technical and research insights by Ahmad Rasti Barzoki on graph machine learning, anomaly detection, analytics engineering, data systems and responsible AI.';

const posts = await getPublishedInsights();
const cards = posts.map((post) => ({
  post,
  readingTime: estimateReadingTime(post.body)
}));

if (!Astro.site) {
  throw new Error('Astro site URL is required for structured data.');
}

const blogSchema = {
  '@type': 'Blog',
  '@id': new URL('/insights#blog', Astro.site).href,
  url: new URL('/insights', Astro.site).href,
  name: 'Insights by Ahmad Rasti Barzoki',
  description,
  author: {
    '@id': new URL('/#person', Astro.site).href
  },
  inLanguage: 'en'
};
---

<BaseLayout
  title={title}
  description={description}
  schema={blogSchema}
  image="/images/hero-presenting.png"
  imageAlt="Insights by Ahmad Rasti Barzoki on AI, data science and research"
>
  <section class="page-hero insights-hero">
    <div class="container">
      <p class="eyebrow">Insights</p>
      <h1>Technical notes, research ideas and lessons from real systems.</h1>
      <p class="lead">
        Long-form writing on graph machine learning, anomaly detection, analytics engineering,
        data systems and responsible AI — focused on methods, trade-offs and practical reasoning.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container insights-list">
      {cards.map(({ post, readingTime }) => (
        <article class="insight-card">
          <div class="insight-card-meta">
            <span class="tag">{post.data.category}</span>
            <span>
              <time datetime={post.data.datePublished.toISOString()}>
                {formatInsightDate(post.data.datePublished)}
              </time>
              {' · '}
              {readingTime}
            </span>
          </div>
          <h2>
            <a href={`/insights/${post.id}`}>{post.data.title}</a>
          </h2>
          <p>{post.data.description}</p>
          <a class="inline-link" href={`/insights/${post.id}`}>Read article →</a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
