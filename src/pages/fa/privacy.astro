---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'حریم خصوصی | احمد راستی برزکی';
const description = 'اطلاعیه حریم خصوصی وب‌سایت احمد راستی برزکی؛ شامل اطلاعات فرم همکاری، تحلیل بازدید، نحوه نگهداری داده و درخواست حذف یا اصلاح اطلاعات.';

const schema = {
  '@type': 'WebPage',
  '@id': 'https://ahmadrastibarzoki.ir/fa/privacy#webpage',
  url: 'https://ahmadrastibarzoki.ir/fa/privacy',
  name: 'حریم خصوصی | احمد راستی برزکی',
  description,
  inLanguage: 'fa'
};
---

<BaseLayout title={title} description={description} schema={schema} alternatePath="/privacy" lang="fa">
  <section class="page-hero privacy-hero">
    <div class="container">
      <p class="eyebrow">حریم خصوصی</p>
      <h1>اطلاعیه حریم خصوصی</h1>
      <p class="lead">این صفحه توضیح می‌دهد چه اطلاعاتی در این وب‌سایت دریافت می‌شود، برای چه هدفی استفاده می‌شود و چگونه می‌توانید درباره اطلاعات ارسالی خود درخواست بررسی، اصلاح یا حذف بدهید.</p>
      <p class="privacy-updated">آخرین به‌روزرسانی: ۲۹ سپتامبر ۲۰۲۶</p>
    </div>
  </section>

  <section class="section">
    <div class="container privacy-layout">
      <aside class="privacy-summary" aria-label="خلاصه حریم خصوصی">
        <strong>خلاصه</strong>
        <p>اطلاعات شخصی شما فروخته نمی‌شود.</p>
        <p>اطلاعات فرم همکاری فقط برای بررسی درخواست و پاسخ به همان درخواست استفاده می‌شود.</p>
        <p>Google Analytics تا زمانی که خودتان اجازه ندهید فعال نمی‌شود.</p>
        <a class="inline-link" href="mailto:contact@ahmadrastibarzoki.ir">contact@ahmadrastibarzoki.ir</a>
      </aside>

      <div class="privacy-content">
        <section>
          <h2>۱. اطلاعاتی که خودتان ارسال می‌کنید</h2>
          <p>اگر فرم همکاری را پر کنید، اطلاعاتی که وارد می‌کنید شامل نام و نام خانوادگی، ایمیل، شرکت یا سازمان (اختیاری)، حوزه همکاری، وضعیت فعلی پروژه، زمان‌بندی تقریبی و توضیحات شما دریافت می‌شود.</p>
          <p>همچنین زبان فرم، صفحه‌ای که فرم از آن ارسال شده، تأیید شما برای ارسال درخواست، زمان ثبت و یک شناسه یکتای تصادفی برای پیگیری درخواست ذخیره می‌شود.</p>
        </section>

        <section>
          <h2>۲. اطلاعات فرم برای چه استفاده می‌شود</h2>
          <p>اطلاعات فرم برای بررسی درخواست، درک بهتر موضوع همکاری و تماس با شما درباره همان درخواست استفاده می‌شود و برای بازاریابی نامرتبط در نظر گرفته نشده است.</p>
        </section>

        <section>
          <h2>۳. پردازش و نگهداری درخواست‌های همکاری</h2>
          <p>اطلاعات فرم از طریق HTTPS به یک Cloudflare Worker ارسال می‌شود. Worker اطلاعات را اعتبارسنجی می‌کند و درخواست را در یک مخزن خصوصی GitHub که برای مدیریت درخواست‌های همکاری استفاده می‌شود، ذخیره می‌کند.</p>
          <p>در دیتاست درخواست‌های همکاری، نشانی IP شما ذخیره نمی‌شود. با این حال Cloudflare ممکن است برای ارائه، امنیت و پایش سرویس Worker برخی اطلاعات فنی درخواست را پردازش کند.</p>
        </section>

        <section>
          <h2>۴. آمار بازدید و ذخیره‌سازی محلی</h2>
          <p>این وب‌سایت فقط زمانی از Google Analytics استفاده می‌کند که گزینه <strong>اجازه می‌دهم</strong> را برای کوکی‌های آماری انتخاب کنید. اگر اجازه ندهید، تگ Google Analytics توسط سایت بارگذاری نمی‌شود.</p>
          <p>انتخاب شما درباره Analytics در مرورگر ذخیره می‌شود تا سایت آن را به خاطر بسپارد. انتخاب حالت روشن یا تیره نیز به‌صورت محلی ذخیره می‌شود. هر زمان بخواهید می‌توانید از گزینه <strong>تنظیمات کوکی</strong> در پایین سایت انتخاب خود را تغییر دهید.</p>
        </section>

        <section>
          <h2>۵. سرویس‌های مورد استفاده</h2>
          <p>این وب‌سایت برای فعالیت خود از زیرساخت‌های شخص ثالث استفاده می‌کند. بسته به نحوه استفاده شما از سایت، اطلاعات ممکن است توسط سرویس‌هایی مانند Cloudflare، GitHub و Google Analytics (فقط در صورت تأیید Analytics) پردازش شود.</p>
        </section>

        <section>
          <h2>۶. مدت نگهداری</h2>
          <p>درخواست‌های همکاری فقط تا زمانی نگهداری می‌شوند که به‌طور معقول برای پاسخ به درخواست، حفظ سوابق حرفه‌ای مرتبط و نگهداری سامانه درخواست‌ها لازم باشد. رکوردهای آزمایشی یا قدیمی ممکن است زودتر حذف شوند.</p>
        </section>

        <section>
          <h2>۷. درخواست درباره اطلاعات شما</h2>
          <p>می‌توانید درباره اطلاعاتی که از طریق این وب‌سایت ارسال کرده‌اید سؤال کنید یا در صورت نیاز درخواست اصلاح یا حذف آن را بدهید. برای پیدا کردن درخواست مرتبط، اطلاعات کافی مانند ایمیل یا کد پیگیری را ذکر کنید.</p>
          <p>ایمیل: <a class="inline-link" href="mailto:contact@ahmadrastibarzoki.ir">contact@ahmadrastibarzoki.ir</a></p>
        </section>

        <section>
          <h2>۸. تغییرات این اطلاعیه</h2>
          <p>اگر ساختار سایت، فرم همکاری، تنظیمات Analytics یا سرویس‌های پشتیبان تغییر کند، ممکن است این صفحه نیز به‌روزرسانی شود. تاریخ آخرین تغییر در بالای صفحه درج می‌شود.</p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
