---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPersianInsights } from '../../utils/insights';

const title = 'احمد راستی برزکی | علم داده، هوش مصنوعی و پژوهش';
const description = 'وب‌سایت شخصی احمد راستی برزکی، که با نام احمد راستی نیز شناخته می‌شود؛ مدیر فناوری، متخصص علم داده و پژوهشگر هوش مصنوعی و یادگیری ماشین با تمرکز بر شبکه‌های عصبی گراف، تشخیص ناهنجاری، مهندسی داده و هوش مصنوعی کاربردی.';

const latestInsights = (await getPublishedPersianInsights()).slice(0, 3);

const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://ahmadrastibarzoki.ir/fa#website-fa',
  url: 'https://ahmadrastibarzoki.ir/fa',
  name: 'احمد راستی برزکی',
  alternateName: [
    'Ahmad Rasti Barzoki',
    'Ahmad Rasti',
    'Rasti Barzoki',
    'احمد راستی',
    'راستی برزکی'
  ],
  creator: {
    '@id': 'https://ahmadrastibarzoki.ir/#person'
  },
  inLanguage: 'fa'
};
---

<BaseLayout
  title={title}
  description={description}
  schema={websiteSchema}
  image="/images/fa-hero-final-wide.webp"
  imageAlt="احمد راستی برزکی، متخصص علم داده و پژوهشگر هوش مصنوعی"
  lang="fa"
>
  <section class="fa-home-hero-v4">
    <img
      class="fa-home-hero-v4-bg"
      src="/images/fa-hero-final-wide-1200.webp"
      srcset="/images/fa-hero-final-wide-720.webp 720w, /images/fa-hero-final-wide-1200.webp 1200w, /images/fa-hero-final-wide.webp 1916w"
      sizes="100vw"
      width="1916"
      height="821"
      alt=""
      fetchpriority="high"
      decoding="async"
    />

    <div class="container fa-home-hero-v4-inner">
      <div class="fa-home-hero-v4-copy">
        <p class="fa-kicker">علم داده · هوش مصنوعی · پژوهش · فناوری</p>

        <h1>احمد راستی برزکی</h1>

        <p class="fa-role">
          مدیر فناوری، متخصص علم داده و پژوهشگر هوش مصنوعی
        </p>

        <p class="fa-home-intro">
          روی پروژه‌هایی کار می‌کنم که بین پژوهش و اجرا قرار می‌گیرند؛ از پژوهش در یادگیری ماشین روی گراف و تشخیص ناهنجاری
          تا طراحی راه‌حل‌های داده‌محور، مهندسی داده و به‌کارگیری عملی هوش مصنوعی در کسب‌وکار و آموزش.
        </p>

        <p class="fa-name-note">
          همچنین با نام <strong>احمد راستی</strong> فعالیت می‌کنم و در برخی آثار علمی با نام
          <span dir="ltr">Ahmad Rasti</span> منتشر شده‌ام.
        </p>

        <div class="fa-home-actions">
          <a class="button primary" href="/fa/projects">مشاهده پروژه‌ها</a>
          <a class="button" href="/fa/about">درباره من</a>
          <a class="button subtle" href="/fa/cv">رزومه</a>
        </div>

        <div class="fa-credibility-strip" aria-label="خلاصه مسیر حرفه‌ای">
          <div>
            <strong>کارشناسی ارشد علم داده</strong>
            <span>دانشگاه صنعتی اصفهان</span>
          </div>
          <div>
            <strong>پژوهش در Graph ML</strong>
            <span>شبکه‌های عصبی گراف و تشخیص ناهنجاری</span>
          </div>
          <div>
            <strong>تجربه اجرایی</strong>
            <span>داده، هوش مصنوعی و فناوری سازمانی</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section fa-home-section">
    <div class="container">
      <div class="fa-section-heading">
        <p class="eyebrow">حوزه‌های کاری و پژوهشی</p>
        <h2>روی چه موضوع‌هایی کار می‌کنم؟</h2>
        <p>
          تمرکز من روی مسائلی است که هم از نظر فنی جدی‌اند و هم در دنیای واقعی کاربرد دارند.
        </p>
      </div>

      <div class="grid">
        <article class="card">
          <span class="tag">پژوهش</span>
          <h3>یادگیری ماشین روی گراف</h3>
          <p>
            شبکه‌های عصبی گراف، یادگیری نمایش، خودرمزگذارهای گرافی
            و تشخیص ناهنجاری بدون نظارت.
          </p>
        </article>

        <article class="card">
          <span class="tag">هوش مصنوعی کاربردی</span>
          <h3>مدل‌ها و سیستم‌های هوشمند</h3>
          <p>
            استفاده از یادگیری ماشین و هوش مصنوعی برای تصمیم‌گیری،
            پیش‌بینی و حل مسائل واقعی.
          </p>
        </article>

        <article class="card">
          <span class="tag">مهندسی داده</span>
          <h3>داده و یکپارچه‌سازی سیستم‌ها</h3>
          <p>
            طراحی پایپ‌لاین‌های قابل‌اعتماد، مهندسی تحلیل و اتصال
            سیستم‌های داده در محیط‌های سازمانی.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section fa-home-section">
    <div class="container">
      <div class="fa-section-heading">
        <p class="eyebrow">تازه‌ترین نوشته‌ها</p>
        <h2>از تجربه پروژه‌ها تا ایده‌های پژوهشی</h2>
        <p>
          درباره موضوع‌هایی می‌نویسم که در پژوهش، پروژه‌های فنی و کار حرفه‌ای با آن‌ها درگیر بوده‌ام.
        </p>
      </div>

      <div class="grid">
        {latestInsights.map((post) => (
          <a class="card insight-home-card" href={`/fa/insights/${post.id}`}>
            <span class="tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>

      <div class="actions">
        <a class="button" href="/fa/insights">مشاهده همه یادداشت‌ها</a>
      </div>
    </div>
  </section>
</BaseLayout>
