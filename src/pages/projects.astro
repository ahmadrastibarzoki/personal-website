---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Projects | Ahmad Rasti Barzoki';
const description = 'Selected open-source projects by Ahmad Rasti Barzoki in graph machine learning, analytics engineering and data integration.';
---

<BaseLayout
  title={title}
  description={description}
  image="/images/project-retail-analytics.png"
  imageAlt="Selected data science and analytics engineering projects by Ahmad Rasti Barzoki"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Selected technical work, built to be inspected.</h1>
      <p class="lead">
        Selected projects spanning research implementation, analytics engineering and enterprise data integration.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container grid">
      <a class="card" href="https://github.com/ahmadrastibarzoki/ChatHandoffKit" target="_blank" rel="noopener noreferrer" aria-label="ChatHandoffKit — open-source project memory CLI">
        <div style="min-height:180px;display:flex;flex-direction:column;justify-content:center;gap:.5rem;padding:1.5rem;border-radius:1rem;background:linear-gradient(135deg,#08182f,#102f49);color:#f8fafc">
          <span style="color:#8ddcdb;font-size:.8rem;letter-spacing:.11em">OPEN SOURCE · PYTHON</span>
          <strong style="font-size:clamp(1.4rem,2.5vw,2rem);line-height:1.15">ChatHandoffKit</strong>
          <span style="color:#d1e6f2">Persistent Project Memory for AI Conversations</span>
          <span style="color:#8ddcdb;font-size:.85rem">Markdown → Checkpoint → Git / Google Drive</span>
        </div>
        <span class="tag">Python · Developer Tools · AI Workflow</span>
        <h3>ChatHandoffKit</h3>
        <p>Open-source CLI for reviewable, versioned AI project memory. Markdown and Git workflows are tested; optional Google Drive support is experimental and awaiting live-account verification.</p>
      </a>

      <a class="card" href="https://github.com/ahmadrastibarzoki/graph-anomaly-detection" target="_blank" rel="noreferrer">
        <img
          class="project-image"
          src="/images/project-graph-anomaly-960.webp"
          srcset="/images/project-graph-anomaly-480.webp 480w, /images/project-graph-anomaly-960.webp 960w"
          sizes="(max-width: 920px) calc(100vw - 2rem), 33vw"
          width="834"
          height="464"
          alt="Graph Anomaly Detection project cover"
          loading="lazy"
          decoding="async"
        />
        <span class="tag">Graph ML · Python</span>
        <h3>Graph Anomaly Detection</h3>
        <p>Reconstructed research implementation of graph autoencoder anomaly detection with GAT and MST-geodesic regularization.</p>
      </a>

      <a class="card" href="https://github.com/ahmadrastibarzoki/retail-analytics-engineering" target="_blank" rel="noreferrer">
        <img
          class="project-image"
          src="/images/project-retail-analytics-960.webp"
          srcset="/images/project-retail-analytics-480.webp 480w, /images/project-retail-analytics-960.webp 960w"
          sizes="(max-width: 920px) calc(100vw - 2rem), 33vw"
          width="838"
          height="478"
          alt="Retail Analytics Engineering project cover"
          loading="lazy"
          decoding="async"
        />
        <span class="tag">Analytics Engineering · Python</span>
        <h3>Retail Analytics Engineering</h3>
        <p>Reproducible clean-room retail analytics engineering project with synthetic data, validation, dimensional analysis, testing and CI.</p>
      </a>

      <a class="card" href="https://github.com/ahmadrastibarzoki/rahkaran-erp-mysql-integration" target="_blank" rel="noreferrer">
        <img
          class="project-image"
          src="/images/project-erp-mysql-960.webp"
          srcset="/images/project-erp-mysql-480.webp 480w, /images/project-erp-mysql-960.webp 960w"
          sizes="(max-width: 920px) calc(100vw - 2rem), 33vw"
          width="837"
          height="474"
          alt="ERP to MySQL Data Integration project cover"
          loading="lazy"
          decoding="async"
        />
        <span class="tag">Data Engineering · Python</span>
        <h3>Rahkaran ERP–MySQL Integration</h3>
        <p>Clean-room reference implementation of a synthetic ERP-to-MySQL integration pipeline.</p>
      </a>
    </div>
  </section>
</BaseLayout>
