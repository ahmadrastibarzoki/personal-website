---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Publications | Ahmad Rasti Barzoki';
const description = 'Research publications and scholarly work by Ahmad Rasti Barzoki in artificial intelligence, machine learning and responsible generative AI.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Publications</p>
      <h1>Research and scholarly work.</h1>
      <p class="lead">
        Publications and selected research outputs across machine learning, applied AI and responsible generative AI.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container publication-grid">
      <img class="publication-cover" src="/images/publication-egenai-dbr.png" alt="EGenAI-DBR publication cover" />
      <article class="list-item">
        <span class="meta">2026 · Peer-reviewed</span>
        <h3>EGenAI-DBR: A Design-Based Framework for Responsible Generative AI Integration in Higher Education</h3>
        <p>Research on responsible and structured integration of generative AI in higher-education settings.</p>
        <div class="actions">
          <a class="button" href="https://scholar.google.com/citations?user=oDTmVngAAAAJ&hl=en" target="_blank" rel="noreferrer">Google Scholar</a>
          <a class="button" href="https://orcid.org/0009-0002-7820-1497" target="_blank" rel="noreferrer">ORCID</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
