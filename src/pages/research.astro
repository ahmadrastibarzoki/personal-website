---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Research | Ahmad Rasti Barzoki';
const description = 'Research interests of Ahmad Rasti Barzoki in graph machine learning, graph neural networks, anomaly detection, representation learning and applied AI.';
---

<BaseLayout
  title={title}
  description={description}
  image="/images/project-graph-anomaly.png"
  imageAlt="Graph machine learning and anomaly detection research by Ahmad Rasti Barzoki"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Research</p>
      <h1>Graph learning, anomaly detection, and applied AI.</h1>
      <p class="lead">
        My research interests center on representation learning, graph-based methods,
        unsupervised learning and applied AI.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container list">
      <article class="list-item">
        <span class="meta">Core area</span>
        <h3>Graph Machine Learning & Graph Neural Networks</h3>
        <p>Graph representation learning, graph autoencoders, attention-based graph models and learning from relational structure.</p>
      </article>
      <article class="list-item">
        <span class="meta">Core area</span>
        <h3>Unsupervised Anomaly Detection</h3>
        <p>Representation-based approaches for identifying unusual nodes, patterns and structures without relying on dense supervision.</p>
      </article>
      <article class="list-item">
        <span class="meta">Applied research</span>
        <h3>AI for Healthcare & Time-Series</h3>
        <p>Machine learning for sensor data, activity monitoring, fall detection and other real-world sequential data settings.</p>
      </article>
      <article class="list-item">
        <span class="meta">Responsible AI</span>
        <h3>Generative AI & AI in Education</h3>
        <p>Responsible integration of generative AI, educational applications and evaluation of AI-assisted learning systems.</p>
      </article>
    </div>
  </section>
</BaseLayout>
