---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact | Ahmad Rasti Barzoki';
const description = 'Contact Ahmad Rasti Barzoki for research, collaboration and professional opportunities.';

const contacts = [
  {
    title: 'Email',
    value: 'ahmadrasti11@gmail.com',
    href: 'mailto:ahmadrasti11@gmail.com',
    icon: '/contact-icons/email.svg',
    note: 'Preferred for professional communication'
  },
  {
    title: 'Telegram',
    value: '@ahmadrastibarzoki',
    href: 'https://t.me/ahmadrastibarzoki',
    icon: '/contact-icons/telegram.svg',
    note: 'Fast direct messaging'
  },
  {
    title: 'Phone',
    value: '+98 913 656 4211',
    href: 'tel:+989136564211',
    icon: '/contact-icons/phone.svg',
    note: 'For important direct contact'
  },
  {
    title: 'Twitter / X',
    value: '@ahmadrasti75',
    href: 'https://x.com/ahmadrasti75',
    icon: '/contact-icons/x.svg',
    note: 'Updates and short posts'
  },
  {
    title: 'LinkedIn',
    value: 'ahmad-rasti-barzoki',
    href: 'https://www.linkedin.com/in/ahmad-rasti-barzoki',
    icon: '/contact-icons/linkedin.svg',
    note: 'Professional profile'
  },
  {
    title: 'GitHub',
    value: 'ahmadrastibarzoki',
    href: 'https://github.com/ahmadrastibarzoki',
    icon: '/contact-icons/github.svg',
    note: 'Code, projects and repositories'
  },
  {
    title: 'Google Scholar',
    value: 'Scholar profile',
    href: 'https://scholar.google.com/citations?user=oDTmVngAAAAJ&hl=en',
    icon: '/contact-icons/scholar.svg',
    note: 'Publications and citations'
  },
  {
    title: 'ORCID',
    value: '0009-0002-7820-1497',
    href: 'https://orcid.org/0009-0002-7820-1497',
    icon: '/contact-icons/orcid.svg',
    note: 'Research identifier'
  }
];
---

<BaseLayout
  title={title}
  description={description}
  image="/images/about-portrait.png"
  imageAlt="Ahmad Rasti Barzoki"
  ogType="profile"
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Let’s connect.</h1>
      <p class="lead">
        For research, collaboration, consulting or professional opportunities, feel free to reach out.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid enhanced-contact-grid">
        {contacts.map((item) => (
          <a class="contact-item contact-item-rich" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
            <img class="contact-icon" src={item.icon} alt="" width="56" height="56" />
            <div>
              <strong>{item.title}</strong>
              <p>{item.value}</p>
              <span class="contact-note">{item.note}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
