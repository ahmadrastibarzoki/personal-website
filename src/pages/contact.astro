---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact | Ahmad Rasti Barzoki';
const description = 'Contact Ahmad Rasti Barzoki for research, collaboration and professional opportunities.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Let’s connect.</h1>
      <p class="lead">
        For research, collaboration, consulting or professional opportunities, feel free to reach out.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        <div class="contact-item">
          <strong>Email</strong>
          <p><a class="inline-link" href="mailto:ahmadrasti11@gmail.com">ahmadrasti11@gmail.com</a></p>
        </div>
        <div class="contact-item">
          <strong>Telegram</strong>
          <p><a class="inline-link" href="https://t.me/ahmadrastibarzoki" target="_blank" rel="noreferrer">@ahmadrastibarzoki</a></p>
        </div>
        <div class="contact-item">
          <strong>Phone</strong>
          <p><a class="inline-link" href="tel:+989136564211">+98 913 656 4211</a></p>
        </div>
        <div class="contact-item">
          <strong>Twitter / X</strong>
          <p><a class="inline-link" href="https://x.com/ahmadrasti75" target="_blank" rel="noreferrer">@ahmadrasti75</a></p>
        </div>
        <div class="contact-item">
          <strong>LinkedIn</strong>
          <p><a class="inline-link" href="https://www.linkedin.com/in/ahmad-rasti-barzoki" target="_blank" rel="noreferrer">ahmad-rasti-barzoki</a></p>
        </div>
        <div class="contact-item">
          <strong>GitHub</strong>
          <p><a class="inline-link" href="https://github.com/ahmadrastibarzoki" target="_blank" rel="noreferrer">ahmadrastibarzoki</a></p>
        </div>
        <div class="contact-item">
          <strong>Google Scholar</strong>
          <p><a class="inline-link" href="https://scholar.google.com/citations?user=oDTmVngAAAAJ&hl=en" target="_blank" rel="noreferrer">Scholar profile</a></p>
        </div>
        <div class="contact-item">
          <strong>ORCID</strong>
          <p><a class="inline-link" href="https://orcid.org/0009-0002-7820-1497" target="_blank" rel="noreferrer">0009-0002-7820-1497</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
