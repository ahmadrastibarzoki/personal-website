---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedInsights } from '../utils/insights';

const title = 'Ahmad Rasti Barzoki | AI, Data Science & Research';
const description = 'Personal website of Ahmad Rasti Barzoki — technology leader, data scientist and AI/ML researcher focused on graph machine learning, anomaly detection, applied AI and data engineering.';

const latestInsights = (await getPublishedInsights()).slice(0, 3);

const websiteSchema = {
  '@type': 'WebSite',
  '@id': 'https://ahmadrastibarzoki.ir/#website',
  url: 'https://ahmadrastibarzoki.ir/',
  name: 'Ahmad Rasti Barzoki',
  alternateName: [
    'Ahmad Rasti',
    'Rasti Barzoki',
    'احمد راستی برزکی',
    'احمد راستی',
    'راستی برزکی'
  ],
  creator: {
    '@id': 'https://ahmadrastibarzoki.ir/#person'
  },
  inLanguage: 'en'
};
---

<BaseLayout
  title={title}
  description={description}
  schema={websiteSchema}
  image="/images/hero-presenting.png"
  imageAlt="Ahmad Rasti Barzoki presenting on stage"
>
  <section class="en-home-hero-v4">
    <img
      class="en-home-hero-v4-bg"
      src="/images/hero-presenting-1800.webp"
      srcset="/images/hero-presenting-720.webp 720w, /images/hero-presenting-1200.webp 1200w, /images/hero-presenting-1800.webp 1800w"
      sizes="100vw"
      width="1672"
      height="941"
      alt=""
      fetchpriority="high"
      decoding="async"
    />

    <div class="container en-home-hero-v4-inner">
      <div class="en-home-hero-v4-copy">
        <p class="en-kicker">AI · DATA SCIENCE · RESEARCH · TECHNOLOGY</p>

        <h1>Ahmad Rasti Barzoki</h1>

        <p class="en-role">
          Technology leader, data scientist, and AI/ML researcher.
        </p>

        <p class="en-home-intro">
          I work across research and production, with a focus on graph machine learning,
          anomaly detection, applied AI, data engineering, and the systems needed to turn
          technical ideas into useful products and decisions.
        </p>

        <p class="en-name-note">
          Also published as <strong>Ahmad Rasti</strong>.
        </p>

        <div class="en-home-actions">
          <a class="button primary" href="/projects">View projects</a>
          <a class="button" href="/research">Research profile</a>
          <a class="button subtle" href="/cv">View CV</a>
        </div>

        <div class="en-credibility-strip" aria-label="Professional highlights">
          <div>
            <strong>M.Sc. in Data Science</strong>
            <span>Isfahan University of Technology</span>
          </div>
          <div>
            <strong>Graph ML research</strong>
            <span>GNNs, representation learning, anomaly detection</span>
          </div>
          <div>
            <strong>Industry experience</strong>
            <span>Data, AI, analytics, and enterprise technology</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section en-home-section">
    <div class="container">
      <div class="en-section-heading">
        <p class="eyebrow">Focus</p>
        <h2>Research depth, production perspective.</h2>
        <p>
          My work sits between machine learning research and real-world data systems,
          with an emphasis on methods that are technically sound and useful in practice.
        </p>
      </div>

      <div class="grid">
        <article class="card">
          <span class="tag">Research</span>
          <h3>Graph Machine Learning</h3>
          <p>Graph neural networks, representation learning, graph autoencoders and unsupervised anomaly detection.</p>
        </article>
        <article class="card">
          <span class="tag">Applied AI</span>
          <h3>Machine Learning Systems</h3>
          <p>Practical AI and analytics systems for decision support, forecasting and data-driven operations.</p>
        </article>
        <article class="card">
          <span class="tag">Engineering</span>
          <h3>Data & Enterprise Integration</h3>
          <p>Reliable data pipelines, analytics engineering and clean integration patterns for enterprise systems.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section en-home-section">
    <div class="container">
      <div class="en-section-heading">
        <p class="eyebrow">Selected work</p>
        <h2>Public projects, built to be inspected.</h2>
        <p>
          Reproducible technical work that reflects my research interests and engineering approach.
        </p>
      </div>

      <div class="grid">
        <a class="card" href="https://github.com/ahmadrastibarzoki/graph-anomaly-detection" target="_blank" rel="noreferrer">
          <img
            class="project-image"
            src="/images/project-graph-anomaly-960.webp"
            srcset="/images/project-graph-anomaly-480.webp 480w, /images/project-graph-anomaly-960.webp 960w"
            sizes="(max-width: 920px) calc(100vw - 2rem), 33vw"
            width="834"
            height="464"
            alt="Graph Anomaly Detection project cover"
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Python · Graph ML</span>
          <h3>Graph Anomaly Detection</h3>
          <p>Research implementation of graph autoencoder anomaly detection with GAT and MST-geodesic regularization.</p>
        </a>

        <a class="card" href="https://github.com/ahmadrastibarzoki/retail-analytics-engineering" target="_blank" rel="noreferrer">
          <img
            class="project-image"
            src="/images/project-retail-analytics-960.webp"
            srcset="/images/project-retail-analytics-480.webp 480w, /images/project-retail-analytics-960.webp 960w"
            sizes="(max-width: 920px) calc(100vw - 2rem), 33vw"
            width="838"
            height="478"
            alt="Retail Analytics Engineering project cover"
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Python · Analytics</span>
          <h3>Retail Analytics Engineering</h3>
          <p>Clean-room analytics engineering project with synthetic data, validation, dimensional analysis, testing and CI.</p>
        </a>

        <a class="card" href="https://github.com/ahmadrastibarzoki/rahkaran-erp-mysql-integration" target="_blank" rel="noreferrer">
          <img
            class="project-image"
            src="/images/project-erp-mysql-960.webp"
            srcset="/images/project-erp-mysql-480.webp 480w, /images/project-erp-mysql-960.webp 960w"
            sizes="(max-width: 920px) calc(100vw - 2rem), 33vw"
            width="837"
            height="474"
            alt="ERP to MySQL Data Integration project cover"
            loading="lazy"
            decoding="async"
          />
          <span class="tag">Python · Data Engineering</span>
          <h3>ERP–MySQL Integration</h3>
          <p>Clean-room reference implementation of a synthetic ERP-to-MySQL integration pipeline.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section en-home-section">
    <div class="container">
      <div class="en-section-heading">
        <p class="eyebrow">Latest insights</p>
        <h2>Research notes and lessons from building real systems.</h2>
        <p>
          Writing on methods, trade-offs, experiments, and the decisions behind practical data and AI systems.
        </p>
      </div>

      <div class="grid">
        {latestInsights.map((post) => (
          <a class="card insight-home-card" href={`/insights/${post.id}`}>
            <span class="tag">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        ))}
      </div>

      <div class="actions">
        <a class="button" href="/insights">View all insights</a>
      </div>
    </div>
  </section>
</BaseLayout>
