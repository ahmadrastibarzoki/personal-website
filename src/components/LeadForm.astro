---
interface Props {
  lang?: 'en' | 'fa';
}
const { lang = 'en' } = Astro.props;
const isFa = lang === 'fa';
const endpoint = import.meta.env.PUBLIC_LEAD_FORM_ENDPOINT || '';

const serviceOptions = isFa
  ? [
      ['data_analytics', 'مشاوره داده و تحلیل کسب‌وکار'],
      ['data_engineering', 'مهندسی داده و یکپارچه‌سازی سیستم‌ها'],
      ['ai_ml', 'راهکارهای هوش مصنوعی و یادگیری ماشین'],
      ['technology_transformation', 'فناوری و تحول دیجیتال'],
      ['training', 'آموزش و کارگاه‌های تخصصی'],
      ['research_collaboration', 'همکاری پژوهشی'],
      ['other', 'موضوع دیگر']
    ]
  : [
      ['data_analytics', 'Data & analytics consulting'],
      ['data_engineering', 'Data engineering & system integration'],
      ['ai_ml', 'AI & machine learning solutions'],
      ['technology_transformation', 'Technology & digital transformation'],
      ['training', 'Training & workshops'],
      ['research_collaboration', 'Research collaboration'],
      ['other', 'Something else']
    ];

const stageOptions = isFa
  ? [
      ['exploring', 'در حال بررسی گزینه‌ها هستم'],
      ['proposal', 'برای تصمیم‌گیری به پیشنهاد و برآورد نیاز دارم'],
      ['ready', 'مسئله مشخص است و آماده شروع هستم'],
      ['ongoing', 'به همکاری یا مشاوره مستمر نیاز دارم']
    ]
  : [
      ['exploring', 'I am exploring options'],
      ['proposal', 'I need a proposal / scoped recommendation'],
      ['ready', 'The problem is defined and I am ready to start'],
      ['ongoing', 'I am looking for ongoing advisory or support']
    ];

const timelineOptions = isFa
  ? [
      ['asap', 'در اولین فرصت'],
      ['2_4_weeks', '۲ تا ۴ هفته آینده'],
      ['1_3_months', '۱ تا ۳ ماه آینده'],
      ['flexible', 'زمان‌بندی منعطف است']
    ]
  : [
      ['asap', 'As soon as practical'],
      ['2_4_weeks', 'Within 2–4 weeks'],
      ['1_3_months', 'Within 1–3 months'],
      ['flexible', 'Flexible']
    ];
---

<section class="lead-form-section" aria-labelledby="lead-form-title">
  <div class="lead-form-shell">
    <div class="lead-form-intro">
      <p class="eyebrow">{isFa ? 'شروع همکاری' : 'Start a conversation'}</p>
      <h2 id="lead-form-title">{isFa ? 'مسئله یا پروژه‌تان را کوتاه توضیح دهید' : 'Tell me a little about the problem or project'}</h2>
      <p>
        {isFa
          ? 'چند نکته کوتاه کافی است. اطلاعات این فرم برای بررسی درخواست و پاسخ‌دادن به شما استفاده می‌شود.'
          : 'A short brief is enough. The information you submit is used to review your inquiry and respond to you.'}
      </p>
    </div>

    <form
      class="lead-form"
      id={isFa ? 'lead-form-fa' : 'lead-form-en'}
      data-lead-form
      data-endpoint={endpoint}
      data-lang={lang}
      novalidate
    >
      <div class="lead-form-grid">
        <label>
          <span>{isFa ? 'نام و نام خانوادگی' : 'Name'}</span>
          <input name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
        </label>

        <label>
          <span>{isFa ? 'ایمیل' : 'Email'}</span>
          <input name="email" type="email" autocomplete="email" maxlength="160" required />
        </label>

        <label>
          <span>{isFa ? 'شرکت / سازمان (اختیاری)' : 'Company / organization (optional)'}</span>
          <input name="organization" type="text" autocomplete="organization" maxlength="160" />
        </label>

        <label>
          <span>{isFa ? 'حوزه همکاری' : 'What can I help with?'}</span>
          <select name="service" required>
            <option value="">{isFa ? 'انتخاب کنید' : 'Select an option'}</option>
            {serviceOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>

        <label>
          <span>{isFa ? 'وضعیت فعلی پروژه' : 'Current stage'}</span>
          <select name="stage" required>
            <option value="">{isFa ? 'انتخاب کنید' : 'Select an option'}</option>
            {stageOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>

        <label>
          <span>{isFa ? 'زمان‌بندی تقریبی' : 'Approximate timeline'}</span>
          <select name="timeline" required>
            <option value="">{isFa ? 'انتخاب کنید' : 'Select an option'}</option>
            {timelineOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
      </div>

      <label class="lead-form-message">
        <span>{isFa ? 'مسئله، هدف یا خروجی موردنظر' : 'Problem, goal, or expected outcome'}</span>
        <textarea
          name="message"
          rows="7"
          minlength="30"
          maxlength="3000"
          required
          placeholder={isFa
            ? 'مثلاً مسئله فعلی چیست، چه داده یا سیستمی دارید و دوست دارید در پایان به چه نتیجه‌ای برسید؟'
            : 'For example: what is the current problem, what data or systems do you have, and what would a useful outcome look like?'}
        ></textarea>
      </label>

      <label class="lead-form-consent">
        <input name="consent" type="checkbox" value="yes" required />
        <span>
          {isFa
            ? 'موافقم اطلاعاتی که در این فرم وارد می‌کنم برای بررسی درخواست و تماس با من استفاده شود.'
            : 'I agree that the information I submit may be used to review my inquiry and contact me about it.'}
        </span>
      </label>

      <label class="lead-form-honeypot" aria-hidden="true">
        <span>Website</span>
        <input name="company_url" type="text" tabindex="-1" autocomplete="off" />
      </label>

      <input type="hidden" name="language" value={lang} />
      <input type="hidden" name="source" value="website_services_form" />

      <div class="lead-form-actions">
        <button class="button primary" type="submit" data-submit-button>{isFa ? 'ارسال درخواست همکاری' : 'Send collaboration inquiry'}</button>
        <a class="button" href={isFa ? '/fa/contact' : '/contact'}>{isFa ? 'راه‌های تماس مستقیم' : 'Direct contact options'}</a>
      </div>

      <p class="lead-form-status" data-form-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const forms = document.querySelectorAll('[data-lead-form]');

  forms.forEach((form) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const endpoint = form.dataset.endpoint || '';
    const lang = form.dataset.lang === 'fa' ? 'fa' : 'en';
    const status = form.querySelector('[data-form-status]');
    const submitButton = form.querySelector('[data-submit-button]');

    const setStatus = (message, state = '') => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      if (!endpoint) {
        setStatus(
          lang === 'fa'
            ? 'فرم هنوز به سرویس دریافت درخواست‌ها متصل نشده است. فعلاً از صفحه تماس استفاده کنید.'
            : 'The form backend is not connected yet. Please use the contact page for now.',
          'error'
        );
        return;
      }

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());
      payload.page_path = window.location.pathname;

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.dataset.originalText = submitButton.textContent || '';
        submitButton.textContent = lang === 'fa' ? 'در حال ارسال…' : 'Sending…';
      }

      setStatus(lang === 'fa' ? 'در حال ارسال درخواست…' : 'Sending your inquiry…', 'pending');

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(result?.error || 'Submission failed');

        form.reset();
        const reference = result?.leadId
          ? String(result.leadId).slice(0, 8).toUpperCase()
          : '';

        setStatus(
          lang === 'fa'
            ? (reference
                ? `درخواست شما با موفقیت ثبت شد. کد پیگیری: ${reference}`
                : 'درخواست شما با موفقیت ثبت شد.')
            : (reference
                ? `Your inquiry was submitted successfully. Reference: ${reference}`
                : 'Your inquiry was submitted successfully.'),
          'success'
        );

        let analyticsConsent = null;
        try {
          analyticsConsent = localStorage.getItem('analytics_consent_v1');
        } catch {}

        if (
          analyticsConsent === 'granted' &&
          window.__ga4Loaded &&
          typeof window.gtag === 'function'
        ) {
          window.gtag('event', 'lead_form_submit', {
            service_interest: payload.service || 'unknown',
            lead_stage: payload.stage || 'unknown',
            form_language: lang,
            page_path: window.location.pathname
          });
        }
      } catch (error) {
        console.error(error);
        setStatus(
          lang === 'fa'
            ? 'ارسال فرم انجام نشد. لطفاً دوباره تلاش کنید یا از صفحه تماس استفاده کنید.'
            : 'The form could not be submitted. Please try again or use the contact page.',
          'error'
        );
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent =
            submitButton.dataset.originalText ||
            (lang === 'fa' ? 'ارسال درخواست همکاری' : 'Send collaboration inquiry');
        }
      }
    });
  });
</script>
