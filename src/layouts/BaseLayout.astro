---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'profile' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleTags?: string[];
  lang?: 'en' | 'fa';
  alternatePath?: string | null;
}

const {
  title,
  description,
  schema,
  image = '/images/hero-presenting.png',
  imageAlt = 'Ahmad Rasti Barzoki - AI, Data Science & Research',
  ogType = 'website',
  publishedTime,
  modifiedTime,
  articleSection,
  articleTags = [],
  lang = 'en',
  alternatePath
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const isFa = lang === 'fa';
const currentPath = Astro.url.pathname;
const autoAlt = isFa
  ? (currentPath === '/fa'
      ? '/'
      : currentPath.startsWith('/fa/')
        ? currentPath.slice(3)
        : '/')
  : (currentPath === '/' ? '/fa' : `/fa${currentPath}`);
const resolvedAlt = alternatePath === undefined ? autoAlt : alternatePath;
const alternateURL = resolvedAlt === null ? null : new URL(resolvedAlt, Astro.site);
const englishURL = isFa ? alternateURL : canonicalURL;
const persianURL = isFa ? canonicalURL : alternateURL;
const navItems = isFa
 ? [['درباره من','/fa/about'],['پژوهش','/fa/research'],['پروژه‌ها','/fa/projects'],['مقالات علمی','/fa/publications'],['یادداشت‌ها','/fa/insights'],['رزومه','/fa/cv'],['تماس','/fa/contact']]
 : [['About','/about'],['Research','/research'],['Projects','/projects'],['Publications','/publications'],['Insights','/insights'],['CV','/cv'],['Contact','/contact']];

const personSchema = {
  '@type': 'Person',
  '@id': 'https://ahmadrastibarzoki.ir/#person',
  name: 'Ahmad Rasti Barzoki',
  alternateName: [
    'Ahmad Rasti',
    'Rasti Barzoki',
    'احمد راستی برزکی',
    'احمد راستی',
    'راستی برزکی'
  ],
  givenName: 'Ahmad',
  familyName: 'Rasti Barzoki',
  description: 'Ahmad Rasti Barzoki, also published as Ahmad Rasti, is a technology leader, data scientist and AI/ML researcher.',
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'ORCID',
    value: '0009-0002-7820-1497',
    url: 'https://orcid.org/0009-0002-7820-1497'
  },
  url: 'https://ahmadrastibarzoki.ir',
  image: 'https://ahmadrastibarzoki.ir/images/about-portrait.png',
  email: 'mailto:ahmadrasti11@gmail.com',
  telephone: '+989136564211',
  sameAs: [
    'https://www.linkedin.com/in/ahmad-rasti-barzoki/',
    'https://github.com/ahmadrastibarzoki',
    'https://scholar.google.com/citations?user=oDTmVngAAAAJ&hl=en',
    'https://orcid.org/0009-0002-7820-1497',
    'https://x.com/ahmadrasti75',
    'https://t.me/ahmadrastibarzoki'
  ],
  jobTitle: 'Technology Leader, Data Scientist and AI/ML Researcher',
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Isfahan University of Technology'
  },
  knowsAbout: [
    'Artificial Intelligence',
    'Machine Learning',
    'Data Science',
    'Graph Machine Learning',
    'Graph Neural Networks',
    'Anomaly Detection',
    'Data Engineering',
    'Applied AI',
    'Responsible Generative AI',
    'هوش مصنوعی','علم داده','شبکه‌های عصبی گراف','تشخیص ناهنجاری'
  ]
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, ...pageSchemas]
};
---

<!doctype html>
<html lang={lang} dir={isFa ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />

    <!-- Google Analytics: Basic Consent Mode -->
    <script is:inline>
      const GA_MEASUREMENT_ID = 'G-9WR3LHVXHC';
      const ANALYTICS_CONSENT_KEY = 'analytics_consent_v1';

      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };

      // Nothing is sent to Google until the Google tag itself is loaded.
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });

      window.loadGoogleAnalytics = function () {
        if (window.__ga4Loaded) return;
        window.__ga4Loaded = true;

        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
        document.head.appendChild(script);

        window.gtag('js', new Date());
        window.gtag('config', GA_MEASUREMENT_ID);
      };

      let storedAnalyticsConsent = null;
      try {
        storedAnalyticsConsent = localStorage.getItem(ANALYTICS_CONSENT_KEY);
      } catch {}

      if (storedAnalyticsConsent === 'granted') {
        window.gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
        window.loadGoogleAnalytics();
      }
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Ahmad Rasti Barzoki" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    {englishURL && persianURL && <>
      <link rel="alternate" hreflang="en" href={englishURL} />
      <link rel="alternate" hreflang="fa" href={persianURL} />
      <link rel="alternate" hreflang="x-default" href={englishURL} />
    </>}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title={isFa ? 'یادداشت‌های احمد راستی برزکی' : 'Insights by Ahmad Rasti Barzoki'} href={isFa ? '/fa/rss.xml' : '/rss.xml'} />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/brand/favicon-64.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />

    {isFa && (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
        <link
          rel="preload"
          as="style"
          href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
        />
        <link
          href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
          rel="stylesheet"
          media="print"
          onload="this.media='all'"
        />
        <noscript>
          <link
            href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
          />
        </noscript>
      </>
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Ahmad Rasti Barzoki" />
    <meta property="og:locale" content={isFa ? 'fa_IR' : 'en_US'} />
    <meta property="og:locale:alternate" content={isFa ? 'en_US' : 'fa_IR'} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content="https://ahmadrastibarzoki.ir/about" />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    {articleTags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@ahmadrasti75" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const initialTheme = storedTheme || (systemDark ? 'dark' : 'light');
      document.documentElement.dataset.theme = initialTheme;
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href={lang === 'fa' ? '/fa' : '/'} aria-label={lang === 'fa' ? 'صفحه اصلی احمد راستی برزکی' : 'Ahmad Rasti Barzoki home'}>
          <img src="/brand/arb-logo-96.webp" alt="" width="44" height="44" />
        </a>
        <nav class="desktop-nav" aria-label={isFa ? 'ناوبری اصلی' : 'Primary navigation'}>
          <a href={isFa ? '/fa' : '/'} aria-current={currentPath === (isFa ? '/fa' : '/') ? 'page' : undefined}>{isFa ? 'خانه' : 'Home'}</a>
          {navItems.map(([label, href]) => <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="header-actions">
          {alternateURL && <a class="language-switch" href={alternateURL.pathname} hreflang={isFa?'en':'fa'} lang={isFa?'en':'fa'}>{isFa?'EN':'فا'}</a>}
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label={isFa?'تغییر حالت رنگ':'Toggle color mode'}>
            <span class="theme-toggle-dark">🌙</span><span class="theme-toggle-light">☀️</span>
          </button>
          <button
            class="mobile-menu-toggle"
            id="mobile-menu-toggle"
            type="button"
            aria-label={isFa ? 'باز کردن فهرست' : 'Open menu'}
            aria-controls="mobile-nav-dialog"
            aria-expanded="false"
          >
            <span class="mobile-menu-icon" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
          </button>
        </div>
      </div>
    </header>

    <dialog
      class="mobile-nav-dialog"
      id="mobile-nav-dialog"
      aria-labelledby="mobile-nav-title"
      dir={isFa ? 'rtl' : 'ltr'}
    >
      <div class="mobile-nav-panel">
        <div class="mobile-nav-head">
          <strong id="mobile-nav-title">{isFa ? 'فهرست' : 'Menu'}</strong>
          <button
            class="mobile-menu-close"
            id="mobile-menu-close"
            type="button"
            aria-label={isFa ? 'بستن فهرست' : 'Close menu'}
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>

        <nav class="mobile-drawer-nav" aria-label={isFa ? 'ناوبری موبایل' : 'Mobile navigation'}>
          <a
            href={isFa ? '/fa' : '/'}
            aria-current={currentPath === (isFa ? '/fa' : '/') ? 'page' : undefined}
          >
            {isFa ? 'خانه' : 'Home'}
          </a>
          {navItems.map(([label, href]) => (
            <a href={href} aria-current={currentPath === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>

        <div class="mobile-nav-meta">
          <span>{isFa ? 'احمد راستی برزکی' : 'Ahmad Rasti Barzoki'}</span>
          {alternateURL && (
            <a
              class="mobile-nav-language"
              href={alternateURL.pathname}
              hreflang={isFa ? 'en' : 'fa'}
              lang={isFa ? 'en' : 'fa'}
            >
              {isFa ? 'English' : 'فارسی'}
            </a>
          )}
        </div>
      </div>
    </dialog>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-wrap">
        <p>© {new Date().getFullYear()} {isFa ? 'احمد راستی برزکی' : 'Ahmad Rasti Barzoki'}</p>
        <div class="footer-links">
          <a href="https://github.com/ahmadrastibarzoki" target="_blank" rel="noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/ahmad-rasti-barzoki/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={isFa?'/fa/cv':'/cv'}>{isFa?'رزومه':'CV'}</a>
          <a href={isFa?'/fa/contact':'/contact'}>{isFa?'تماس':'Contact'}</a>
          <button class="footer-consent-button" id="cookie-settings" type="button">{isFa?'تنظیمات کوکی':'Cookie settings'}</button>
        </div>
      </div>
    </footer>

    <div
      class="consent-banner"
      id="analytics-consent-banner"
      role="dialog"
      aria-labelledby="analytics-consent-title"
      aria-describedby="analytics-consent-description"
      hidden
    >
      <div class="consent-banner-inner">
        <div class="consent-copy">
          <strong id="analytics-consent-title">{isFa?'کوکی‌های آماری':'Analytics cookies'}</strong>
          <p id="analytics-consent-description">
            {isFa
              ? 'این وب‌سایت فقط با اجازه شما از Google Analytics برای تحلیل استفاده بازدیدکنندگان استفاده می‌کند. تا زمانی که اجازه ندهید Analytics غیرفعال می‌ماند.'
              : 'This website uses optional Google Analytics cookies to understand how visitors use the site. Analytics stays off until you choose to allow it. You can change your choice anytime from Cookie settings.'}
          </p>
        </div>
        <div class="consent-actions">
          <button class="button primary" id="accept-analytics" type="button">{isFa?'اجازه می‌دهم':'Accept analytics'}</button>
          <button class="button" id="reject-analytics" type="button">{isFa?'رد می‌کنم':'Reject'}</button>
        </div>
      </div>
    </div>

    <script is:inline>
      const root = document.documentElement;
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          localStorage.setItem('theme', nextTheme);
        });
      }
    </script>
    <script is:inline>
      const consentBanner = document.getElementById('analytics-consent-banner');
      const acceptAnalytics = document.getElementById('accept-analytics');
      const rejectAnalytics = document.getElementById('reject-analytics');
      const cookieSettings = document.getElementById('cookie-settings');

      const readAnalyticsConsent = () => {
        try {
          return localStorage.getItem(ANALYTICS_CONSENT_KEY);
        } catch {
          return null;
        }
      };

      const saveAnalyticsConsent = (value) => {
        try {
          localStorage.setItem(ANALYTICS_CONSENT_KEY, value);
        } catch {}
      };

      const showConsentBanner = () => {
        if (consentBanner) consentBanner.hidden = false;
      };

      const hideConsentBanner = () => {
        if (consentBanner) consentBanner.hidden = true;
      };

      if (!readAnalyticsConsent()) {
        showConsentBanner();
      }

      acceptAnalytics?.addEventListener('click', () => {
        saveAnalyticsConsent('granted');

        window.gtag?.('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });

        window.loadGoogleAnalytics?.();
        hideConsentBanner();
      });

      rejectAnalytics?.addEventListener('click', () => {
        const wasGranted = readAnalyticsConsent() === 'granted';
        saveAnalyticsConsent('denied');

        window.gtag?.('consent', 'update', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });

        hideConsentBanner();

        // If Analytics was already loaded in this tab, reload so it remains blocked.
        if (wasGranted) window.location.reload();
      });

      cookieSettings?.addEventListener('click', () => {
        showConsentBanner();
      });
    </script>
    <script is:inline>
      // High-value analytics events. These are only sent after analytics consent is granted.
      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('a[href]');
        if (!link) return;

        let analyticsConsent = null;
        try {
          analyticsConsent = localStorage.getItem(ANALYTICS_CONSENT_KEY);
        } catch {}

        if (
          analyticsConsent !== 'granted' ||
          !window.__ga4Loaded ||
          typeof window.gtag !== 'function'
        ) {
          return;
        }

        const href = link.getAttribute('href') || '';
        const pagePath = window.location.pathname;

        let eventName = null;
        const parameters = {
          page_path: pagePath
        };

        // CV PDF download
        if (href.includes('/cv/Ahmad_Rasti_Barzoki_CV.pdf')) {
          eventName = 'cv_download';
          parameters.asset = 'public_cv';
        }

        // Direct contact actions
        else if (href.startsWith('mailto:')) {
          eventName = 'contact_click';
          parameters.channel = 'email';
        }
        else if (href.startsWith('tel:')) {
          eventName = 'contact_click';
          parameters.channel = 'phone';
        }
        else if (href.includes('t.me/')) {
          eventName = 'contact_click';
          parameters.channel = 'telegram';
        }

        // Publication actions
        else if (href.includes('doi.org/')) {
          eventName = 'publication_click';
          parameters.destination = 'doi';
        }
        else if (href.includes('emerald.com/')) {
          eventName = 'publication_click';
          parameters.destination = 'publisher';
        }

        // Public project repository actions
        else if (href.includes('github.com/ahmadrastibarzoki/graph-anomaly-detection')) {
          eventName = 'project_click';
          parameters.project = 'graph_anomaly_detection';
        }
        else if (href.includes('github.com/ahmadrastibarzoki/retail-analytics-engineering')) {
          eventName = 'project_click';
          parameters.project = 'retail_analytics_engineering';
        }
        else if (href.includes('github.com/ahmadrastibarzoki/rahkaran-erp-mysql-integration')) {
          eventName = 'project_click';
          parameters.project = 'rahkaran_erp_mysql_integration';
        }

        // Professional / academic profiles
        else if (href.includes('linkedin.com/')) {
          eventName = 'profile_click';
          parameters.platform = 'linkedin';
        }
        else if (href.includes('github.com/ahmadrastibarzoki')) {
          eventName = 'profile_click';
          parameters.platform = 'github';
        }
        else if (href.includes('scholar.google.com/')) {
          eventName = 'profile_click';
          parameters.platform = 'google_scholar';
        }
        else if (href.includes('orcid.org/')) {
          eventName = 'profile_click';
          parameters.platform = 'orcid';
        }
        else if (href.includes('x.com/ahmadrasti75')) {
          eventName = 'profile_click';
          parameters.platform = 'x';
        }

        if (eventName) {
          window.gtag('event', eventName, parameters);
        }
      });
    </script>
    <script is:inline>
      const mobileNavDialog = document.getElementById('mobile-nav-dialog');
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenuClose = document.getElementById('mobile-menu-close');

      const setMobileMenuState = (open) => {
        mobileMenuToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
        document.body.classList.toggle('mobile-nav-open', open);
      };

      const openMobileMenu = () => {
        if (!(mobileNavDialog instanceof HTMLDialogElement) || mobileNavDialog.open) return;
        mobileNavDialog.showModal();
        setMobileMenuState(true);
        mobileMenuClose?.focus();
      };

      const closeMobileMenu = () => {
        if (!(mobileNavDialog instanceof HTMLDialogElement) || !mobileNavDialog.open) return;
        mobileNavDialog.close();
      };

      mobileMenuToggle?.addEventListener('click', openMobileMenu);
      mobileMenuClose?.addEventListener('click', closeMobileMenu);

      mobileNavDialog?.addEventListener('click', (event) => {
        if (event.target === mobileNavDialog) closeMobileMenu();
      });

      mobileNavDialog?.querySelectorAll('a[href]').forEach((link) => {
        link.addEventListener('click', closeMobileMenu);
      });

      mobileNavDialog?.addEventListener('close', () => {
        setMobileMenuState(false);
        mobileMenuToggle?.focus();
      });

      const desktopNavQuery = window.matchMedia('(min-width: 901px)');
      desktopNavQuery.addEventListener('change', (event) => {
        if (event.matches) closeMobileMenu();
      });
    </script>
  </body>
</html>
