---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import {
  estimateReadingTime,
  formatInsightDate,
  insightModifiedDate
} from '../utils/insights';

interface Props {
  post: CollectionEntry<'insights'>;
}

const { post } = Astro.props;
const { data } = post;

if (!Astro.site) {
  throw new Error('Astro site URL is required for canonical and structured data.');
}

const canonical = new URL(`/insights/${post.id}`, Astro.site).href;
const imageURL = new URL(data.image, Astro.site).href;
const modifiedDate = insightModifiedDate(post);
const publishedISO = data.datePublished.toISOString();
const modifiedISO = modifiedDate.toISOString();
const wasModified = modifiedDate.getTime() > data.datePublished.getTime();
const readingTime = estimateReadingTime(post.body);

const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#article`,
  headline: data.title,
  description: data.description,
  url: canonical,
  mainEntityOfPage: canonical,
  image: imageURL,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  author: {
    '@id': new URL('/#person', Astro.site).href,
    '@type': 'Person',
    name: 'Ahmad Rasti Barzoki',
    url: new URL('/about', Astro.site).href
  },
  isPartOf: {
    '@id': new URL('/insights#blog', Astro.site).href
  },
  articleSection: data.category,
  keywords: data.keywords,
  inLanguage: 'en'
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Insights',
      item: new URL('/insights', Astro.site).href
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: canonical
    }
  ]
};
---

<BaseLayout
  title={`${data.title} | Ahmad Rasti Barzoki`}
  description={data.description}
  schema={[articleSchema, breadcrumbSchema]}
  image={data.image}
  imageAlt={data.imageAlt}
  ogType="article"
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
  articleSection={data.category}
  articleTags={data.keywords}
>
  <article class="article-page">
    <header class="article-header">
      <div class="container article-container">
        <a class="article-back" href="/insights">← All insights</a>
        <p class="eyebrow">{data.category}</p>
        <h1>{data.title}</h1>
        <p class="article-deck">{data.description}</p>
        <div class="article-meta">
          <a href="/about" rel="author">Ahmad Rasti Barzoki</a>
          <span aria-hidden="true">·</span>
          <time datetime={publishedISO}>Published {formatInsightDate(data.datePublished)}</time>
          {wasModified && (
            <>
              <span aria-hidden="true">·</span>
              <time datetime={modifiedISO}>Updated {formatInsightDate(modifiedDate)}</time>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{readingTime}</span>
        </div>
      </div>
    </header>

    <div class="container article-container article-body">
      <div class="article-summary">
        <strong>Key idea</strong>
        <p>{data.summary}</p>
      </div>

      <slot />

      {data.sources.length > 0 && (
        <section class="article-sources" aria-labelledby="article-sources-title">
          <h2 id="article-sources-title">Sources & further reading</h2>
          <ul>
            {data.sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noreferrer">{source.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <aside class="article-author">
        <div>
          <span class="meta">Author</span>
          <h3><a href="/about" rel="author">Ahmad Rasti Barzoki</a></h3>
          <p>
            Technology leader, Data Scientist and AI/ML researcher working across graph machine learning,
            anomaly detection, analytics engineering, data engineering and responsible AI.
          </p>
        </div>
        <div class="actions">
          <a class="button" href="/about">About</a>
          <a class="button" href="/research">Research</a>
          <a class="button" href="/contact">Contact</a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
